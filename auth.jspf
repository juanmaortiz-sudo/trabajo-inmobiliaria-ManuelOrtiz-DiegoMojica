<%@ page import="javax.servlet.http.HttpSession" %>
<%
    HttpSession sesion = request.getSession(false);
    Integer idUsuario = (sesion != null) ? (Integer) sesion.getAttribute("id_usuario") : null;
    String rol = (sesion != null) ? (String) sesion.getAttribute("rol") : "visitante";
    boolean autenticado = (idUsuario != null);

    boolean esAdmin = "administrador".equalsIgnoreCase(rol);
    boolean esInmob = "inmobiliaria".equalsIgnoreCase(rol);
    boolean esCliente = "cliente".equalsIgnoreCase(rol);
    boolean esVisitante = !autenticado || "visitante".equalsIgnoreCase(rol);

    // ID de inmobiliaria del usuario logueado (para inmobiliaria/admin)
    Integer idInmobiliariaUsuario = null;
    if (autenticado && (esInmob || esAdmin) && conexion != null) {
        PreparedStatement ps = null;
        ResultSet rs = null;
        try {
            ps = conexion.prepareStatement("SELECT id_inmobiliaria FROM inmobiliaria WHERE id_usuario = ?");
            ps.setInt(1, idUsuario);
            rs = ps.executeQuery();
            if (rs.next()) {
                idInmobiliariaUsuario = rs.getInt("id_inmobiliaria");
            }
        } catch (Exception e) { } finally {
            if (rs != null) { try { rs.close(); } catch (SQLException e) { } }
            if (ps != null) { try { ps.close(); } catch (SQLException e) { } }
        }
    }
%>